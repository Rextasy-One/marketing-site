# OAuth provider credentials — copy to `.env.local` and fill in.
#
# Nothing here is committed with values; `.env*.local` is gitignored.
# Until a provider's two values are set, its button on /login renders disabled.
#
# Auth.js reads these by convention: AUTH_<PROVIDER>_ID and AUTH_<PROVIDER>_SECRET.

# Required in every environment: the origin the browser talks to.
# Dev: the TLS proxy on 3000 (see docs/LOCAL-HTTPS.md).
AUTH_URL=https://localhost:3000

# A random string used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Google ---------------------------------------------------------------
# Console: APIs & Services → Credentials → Create credentials → OAuth client ID (Web)
# Authorized redirect URI (exact match, no wildcards):
#   https://localhost:3000/api/auth/callback/google
# http://localhost is also accepted by Google for local development.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Facebook -------------------------------------------------------------
# Meta for Developers → your app → Facebook Login → Settings → Valid OAuth Redirect URIs
#   https://localhost:3000/api/auth/callback/facebook
# Add the Facebook Login product and switch the app to Live for production; in
# Development mode only app-role accounts can authenticate.
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# --- Apple ----------------------------------------------------------------
# Apple does NOT accept `localhost` as a redirect URI. Use a hosts-file alias:
#   sudo sh -c 'echo "127.0.0.1 rexstaples.local" >> /etc/hosts'
# then register https://rexstaples.local:3000/api/auth/callback/apple
# (also add `rexstaples.local` to the cert — see docs/LOCAL-HTTPS.md).
#
# AUTH_APPLE_SECRET is NOT the .p8 key. It is a JWT signed with it:
#   header  { "alg": "ES256", "kid": "<Key ID>" }
#   payload { "iss": "<Team ID>", "iat": now, "exp": now + 15777000,
#             "aud": "https://appleid.apple.com", "sub": "<Services ID>" }
# It EXPIRES every 6 months — rotate it or sign-in breaks silently.
# Generate with Auth.js:
#   npx auth add apple --generate-secret
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
